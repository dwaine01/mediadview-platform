# ═══════════════════════════════════════════════════════════════════
# MediAd View — .gitignore
# ═══════════════════════════════════════════════════════════════════
# NEVER COMMIT SECRETS, KEYS, TOKENS, PASSWORDS, OR ENV VALUES.

# ─── Secrets & environment ─────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
credentials.json
service-account.json
firebase-adminsdk*.json
google-services.json
.git-credentials
.netrc
.gitignore-tmp

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.hypothesis/
coverage.xml
*.cover
*.py,cover
.pyre/
.pytype/
cython_debug/
.venv/
venv/
env/
ENV/

# ─── Node / Frontend ───────────────────────────────────────────────
node_modules/
/node_modules
/.pnp
.pnp.js
.pnp.cjs
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.next/
out/
.nuxt/
.parcel-cache/
.cache/
.vite/
.swc/

# ─── Expo / React Native ───────────────────────────────────────────
.expo/
.expo-shared/
web-build/
expo-env.d.ts

# ─── Android Player build artifacts ───────────────────────────────
android-player/.gradle/
android-player/**/build/
android-player/**/.idea/
android-player/local.properties
android-player/app/release/
android-player/**/captures/
*.iml
*.hprof
gradle-app.setting
.gradletasknamecache

# ─── APK / signed artifacts ─────────────────────────────────────────
*.jks
*.aab
# Existing production APK aliases remain tracked for compatibility. New builds
# are distributed by Codemagic/GitHub Actions artifacts, never committed by CI.
dist/
build-artifacts/
.build-logs/

# ─── Testing / coverage ────────────────────────────────────────────
coverage/
.coverage/
test-results/
playwright-report/
tests/__snapshots__/

# ─── OS / IDE ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.project
.classpath

# ─── Logs ──────────────────────────────────────────────────────────
*.log
logs/
supervisor.log
uvicorn.log

# ─── Locks (allow package-lock/yarn.lock, ignore build locks) ─────
*.pid
*.seed
*.pid.lock
# keep yarn.lock and package-lock.json (needed for reproducible installs)

# ─── Media / uploads / user-generated files ────────────────────────
backend/media/*
uploads/
tmp/
*.tmp

# ─── DB dumps ──────────────────────────────────────────────────────
*.bson
dump/
mongodump/

# ─── Docker / cloud ────────────────────────────────────────────────
.dockerignore.bak

# ─── Emergent build outputs ────────────────────────────────────────
.emergent/
frontend/tsconfig.tsbuildinfo
frontend/frontend.log

# ─── Local memory / credentials tracking (contains dev passwords) ──
memory/test_credentials.md
!memory/test_credentials.md.example


# ─── P0-A5 test artefacts (Playwright + reports) ─────────────────
test_reports/
playwright-report/
.playwright/
pw-browsers/
tests/screenshots/
*.har
*.env
.credentials
