# ═════════════════════════════════════════════════════════════════
# MediaDView — Environment Variables Template
# ═════════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file to `.env` (never commit `.env` to git).
#   2. Fill in real values for your environment.
#   3. [REQUIRED] MUST be set or the app fails to start.
#   4. [OPTIONAL] have safe defaults.
#   5. [PROD-ONLY] should only be set in production.
#   6. [DEV-ONLY] should NEVER exist in production.
# SECURITY:
#   · NEVER commit real values.
#   · Rotate JWT_SECRET / FERNET_KEY / ORDER_LINK_SECRET every 6 months.
#   · Store production secrets in Render's Environment tab, not files.
# LAST REVIEWED: production readiness audit (Sprint 1 · Week 1)
# ═════════════════════════════════════════════════════════════════

# ─── Core: Database & Environment ───────────────────────────────
# [REQUIRED] MongoDB connection string
#   Dev:  mongodb://localhost:27017
#   Prod: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb://localhost:27017

# [REQUIRED] Database name (do NOT reuse across environments)
DB_NAME=mediadview_prod

# [REQUIRED] Environment tag — controls seed behaviour + logging
#   values: development | staging | production
ENVIRONMENT=production

# [OPTIONAL] Release tag; auto-populated by Render as commit SHA
APP_RELEASE=

# [OPTIONAL] Log level: DEBUG | INFO | WARNING | ERROR (default INFO)
LOG_LEVEL=INFO


# ─── Auth v2 (JWT + HttpOnly cookies + Fernet) ──────────────────
# [REQUIRED] JWT signing secret. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_64

# [REQUIRED] Fernet encryption key. Generate ONCE with:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Rotating this invalidates all active refresh tokens.
FERNET_KEY=CHANGE_ME_generate_with_Fernet_generate_key

# [OPTIONAL] JWT issuer + audience
JWT_ISSUER=mediadview
JWT_AUDIENCE=mediadview-api

# [OPTIONAL] Access token lifetime (minutes) — default 15
JWT_ACCESS_TOKEN_MINUTES=15

# [OPTIONAL] Refresh token lifetime (days) — default 14
JWT_REFRESH_TOKEN_DAYS=14

# [OPTIONAL] Legacy JWT expiration (hours) — default 24
JWT_LEGACY_EXPIRATION_HOURS=24

# [OPTIONAL] Brute-force protection
LOCKOUT_MAX_FAIL=5
LOCKOUT_WINDOW_MIN=15


# ─── Cookies ────────────────────────────────────────────────────
# [PROD-ONLY] Must be `true` in production (requires HTTPS)
COOKIE_SECURE=true

# [PROD-ONLY] Cookie domain. Must be a suffix of the site.
#   Example: .mediadview.com  (leading dot allows subdomains)
COOKIE_DOMAIN=.mediadview.com

# [OPTIONAL] SameSite policy: Lax | Strict | None (default Lax)
COOKIE_SAMESITE=Lax


# ─── Public URLs & CORS ─────────────────────────────────────────
# [REQUIRED] Absolute base URL (used in magic links + PDFs). NO trailing slash.
PUBLIC_BASE_URL=https://app.mediadview.com

# [REQUIRED] Comma-separated allowed CORS origins (ALL frontends).
CORS_ORIGINS=https://mediadview.com,https://app.mediadview.com


# ─── Order links (magic-link tokens for guest checkout) ─────────
# [REQUIRED] HMAC secret for signing magic-link tokens.
ORDER_LINK_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_32

# [OPTIONAL] Magic-link expiration (days) — default 30
ORDER_TOKEN_TTL_DAYS=30


# ─── Checkout / slot reservation TTLs ───────────────────────────
CHECKOUT_QUOTE_TTL_SECONDS=900
CHECKOUT_SESSION_TTL_SECONDS=3600
CHECKOUT_SLOT_TTL_SECONDS=1200
DEFAULT_HOURLY_RATE_CENTS=500


# ─── Media limits ───────────────────────────────────────────────
MEDIA_IMG_MAX_MB=15
MEDIA_VID_MAX_MB=100
MEDIA_VID_MAX_SEC=90
MEDIA_PRESIGN_TTL=300
GUEST_MEDIA_MAX_BYTES=100000000

# [OPTIONAL] Local media dir (dev fallback when R2 not configured)
# In production leave EMPTY; media MUST go to R2.
MEDIA_DIR=


# ─── Cloudflare R2 (object storage) ─────────────────────────────
# [REQUIRED IN PROD]
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mediadview-prod
R2_ACCOUNT_ID=
R2_PUBLIC_BASE_URL=


# ─── Redis (cache + rate limiting + ARQ worker) ─────────────────
# [REQUIRED] Use `rediss://` (TLS) in prod.
#   Prod: rediss://default:<pass>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# [OPTIONAL] Prefix for keys
REDIS_PREFIX=mediadview

# [OPTIONAL] Timeout (s) — default 5
REDIS_TIMEOUT=5


# ─── ARQ worker configuration ───────────────────────────────────
# [OPTIONAL] Mode: internal | worker — default internal
SCHEDULER_MODE=worker
WORKER_MAX_JOBS=10
WORKER_IDEM_TTL=3600
WORKER_JOB_TIMEOUT=300
WORKER_KEEP_RESULT=3600
WORKER_MAX_RETRIES=3


# ─── Payments · Stripe [pending "Stripe listo"] ─────────────────
# [OPTIONAL] Payment provider: stripe | dev
#   Leave EMPTY → auto-detects stripe when STRIPE_SECRET_KEY is set.
PAYMENT_PROVIDER=

# [OPTIONAL] When empty, falls back to LocalDevProvider.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# [DEV-ONLY] Never set in production.
STRIPE_WEBHOOK_SECRET_ALLOW_EMPTY=


# ─── Colorlight A40 timezones ──────────────────────────────────
COLORLIGHT_TZ=America/Santo_Domingo
MENU_TZ=America/Santo_Domingo


# ─── Email (Resend) ─────────────────────────────────────────────
# [REQUIRED IN PROD]
RESEND_API_KEY=
EMAIL_FROM=notifications@mediadview.com
EMAIL_FROM_NAME=MediaDView


# ─── Observability · Sentry ─────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.0


# ─── Seeding (one-shot bootstrap) ───────────────────────────────
# [PROD-ONLY, ONE-SHOT] Used only if no admin exists yet.
# After first login → REMOVE these and set SKIP_SEED=true.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# [PROD] Once superadmin exists, set to true to disable auto-seed.
SKIP_SEED=true


# ─── Destructive tooling ────────────────────────────────────────
# [DEV/STAGING ONLY] Required (=1) to allow tools/reset_for_production.py.
MEDIADVIEW_ALLOW_RESET=


# ─── Deprecated / no longer used ────────────────────────────────
# The variables below have been REMOVED from the template intentionally.
# If you see them in old .env files, delete them:
#   EXPO_PACKAGER_PROXY_URL       (Expo — MediaDView is web-only)
#   EXPO_PACKAGER_HOSTNAME        (same)
#   EMERGENT_PUSH_KEY             (push — not implemented)
#   EMERGENT_LLM_KEY              (LLM — not used in core)
